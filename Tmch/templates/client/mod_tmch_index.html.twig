{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}{{ 'TMCH Claims Notice'|trans }}{% endblock %}

{% block body_class %}tmch{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active" aria-current="page"><a href="#">{{ 'TMCH Claims Notice'|trans }}</a></li>{% endblock %}

{% block page_header %}
<article class="page-header">
    <h1>{{ 'TMCH Claims Notice'|trans }}</h1>
</article>
{% endblock%}

{% block content %}
  <div class="row justify-content-center">
    <div class="col-12">

      <div class="card shadow-sm">
        <div class="card-header d-flex align-items-center justify-content-between">
          <div>
            <h5 class="mb-0">{{ 'Trademark Claims Notice'|trans }}</h5>
            <div class="text-muted small">
              {{ 'Review the notice below before continuing with registration.'|trans }}
            </div>
          </div>
        </div>

        <div class="card-body">

          {% if error %}
            <div class="alert alert-danger mb-0">
              <strong>{{ 'Unable to load notice'|trans }}.</strong>
              <div class="small mt-1">{{ error }}</div>
            </div>

          {% elseif note %}
            <pre class="border rounded p-3 mb-0 bg-body text-body"
                style="max-height: 520px; overflow:auto; white-space: pre-wrap; word-break: break-word;">
{{ note|e }}
            </pre>

          {% else %}
            <div class="alert alert-warning mb-0">
              {{ 'No lookupKey provided in the URL.'|trans }}
            </div>
          {% endif %}

        </div>
      </div>

    </div>
  </div>
{% endblock %}