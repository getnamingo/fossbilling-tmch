{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}{{ 'TMCH Claims Notice'|trans }}{% endblock %}

{% block body_class %}tmch{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active" aria-current="page"><a href="#">{{ 'TMCH Claims Notice'|trans }}</a></li>{% endblock %}

{% block page_header %}
<article class="page-header">
    <h1>{{ 'TMCH Claims Notice'|trans }}</h1>
</article>
{% endblock%}

{% block content %}
<div class="row">
    <article class="span12 data-block">
        <div class="data-container">
            <section>
            {% if error %}
              <div class="alert alert-danger">{{ error }}</div>
            {% elseif note %}
              <div class="alert alert-info">
                Claims notice:<br>
                {{ note|e|nl2br|raw }}
              </div>
            {% else %}
              <div class="alert alert-warning">No lookupKey provided in the URL.</div>
            {% endif %}
            </section>
        </div>
    </article>
</div>
{% endblock %}